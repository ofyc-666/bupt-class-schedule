<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 登录请求只允许 HTTPS，并仅信任 Android 系统 CA。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
