<?xml version="1.0" encoding="utf-8"?>
<com.bupt.schedule.ui.DetailScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/custom_editor_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_drag_handle" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/custom_editor_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_tag_custom"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/custom_assignment_tag"
                android:textColor="#6574C8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/custom_cancel_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <TextView
            android:id="@+id/custom_editor_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:text="@string/custom_assignment_title"
            android:textColor="#1E2941"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_course_detail_card"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="&#x4f5c;&#x4e1a;&#x540d;&#x79f0;"
                    android:textColor="#8F9BB3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/custom_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/custom_assignment_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#222B45"
                    android:textColorHint="#B0BACE"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:background="#EDF1F7" />

            <LinearLayout
                android:id="@+id/custom_course_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="&#x6240;&#x5c5e;&#x8bfe;&#x7a0b;"
                    android:textColor="#8F9BB3"
                    android:textSize="13sp" />

                <AutoCompleteTextView
                    android:id="@+id/custom_course"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:completionThreshold="1"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/custom_assignment_course_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#222B45"
                    android:textColorHint="#B0BACE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/custom_pick_course"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_custom_assignment_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="&#x4ece;&#x8bfe;&#x8868;&#x9009;&#x0020;&#x203a;"
                    android:textColor="#5665A5"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:background="#EDF1F7" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="&#x622a;&#x6b62;&#x65f6;&#x95f4;"
                    android:textColor="#8F9BB3"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_clock" />

                    <Button
                        android:id="@+id/custom_date"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_filter_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:stateListAnimator="@null"
                        android:text="2026-10-14"
                        android:textColor="#BD5267"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/custom_time"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_filter_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:stateListAnimator="@null"
                        android:text="23:59"
                        android:textColor="#BD5267"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="11dp"
                android:layout_marginBottom="11dp"
                android:background="#EDF1F7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="&#x4f5c;&#x4e1a;&#x8bf4;&#x660e;"
                    android:textColor="#8F9BB3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/custom_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/custom_assignment_description_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="3dp"
                    android:minLines="2"
                    android:maxLines="4"
                    android:textColor="#222B45"
                    android:textColorHint="#B0BACE"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/custom_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_error_message"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="#A9495D"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/custom_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/custom_assignment_cancel"
                android:textColor="#748197"
                android:textSize="15sp" />

            <Button
                android:id="@+id/custom_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_course_detail_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/custom_assignment_save"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</com.bupt.schedule.ui.DetailScrollView>
