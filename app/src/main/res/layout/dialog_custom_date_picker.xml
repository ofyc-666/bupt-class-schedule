<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Top Header: Badge + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tag_custom"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="&#x622a;&#x6b62;&#x65e5;&#x671f;"
            android:textColor="#6574C8"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/date_picker_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:text="&#x9009;&#x62e9;&#x622a;&#x6b62;&#x65e5;&#x671f;"
        android:textColor="#1E2941"
        android:textSize="20sp" />

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_course_detail_card"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Quick Shortcut Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/date_chip_today"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#x4eca;&#x5929;"
                android:textColor="#4F5D75"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/date_chip_tomorrow"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#x660e;&#x5929;"
                android:textColor="#4F5D75"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/date_chip_this_sunday"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#x672c;&#x5468;&#x65e5;"
                android:textColor="#4F5D75"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/date_chip_next_sunday"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="&#x4e0b;&#x5468;&#x65e5;"
                android:textColor="#4F5D75"
                android:textSize="12.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:background="#EAEFF8" />

        <!-- Wheel Picker Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="60dp"
                android:background="#E2E6EE" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="120dp"
                android:background="#E2E6EE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <NumberPicker
                    android:id="@+id/picker_year"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:descendantFocusability="blocksDescendants" />

                <NumberPicker
                    android:id="@+id/picker_month"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:descendantFocusability="blocksDescendants" />

                <NumberPicker
                    android:id="@+id/picker_day"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:descendantFocusability="blocksDescendants" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/date_picker_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="&#x53d6;&#x6d88;"
            android:textColor="#748197"
            android:textSize="15sp" />

        <Button
            android:id="@+id/date_picker_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_course_detail_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="&#x786e;&#x5b9a;"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
