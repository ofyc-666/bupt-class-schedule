<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_assignment_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row: Course Tag + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:id="@+id/card_course_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_week_badge" android:ellipsize="end" android:singleLine="true"
            android:fontFamily="sans-serif-medium" android:paddingStart="9dp" android:paddingEnd="9dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#554A86" android:textSize="11.5sp" />
        </FrameLayout>
        <TextView android:id="@+id/card_custom_badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_custom" android:text="@string/custom_assignment_tag" android:textColor="#6574C8"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="11.5sp" android:fontFamily="sans-serif-medium" android:visibility="gone" />
        <TextView android:id="@+id/card_status_badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:background="@drawable/bg_tag_pending" android:textColor="#BD5267"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="11.5sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Assignment Title -->
    <TextView
        android:id="@+id/card_assignment_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:text="&#x4f5c;&#x4e1a;&#x6807;&#x9898;"
        android:textColor="#1E2941"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/card_assignment_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="作业说明见详情"
        android:textColor="#748197"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="10dp"
        android:background="#F1F4F8" />

    <!-- Footer Row: Clock + Deadline + Remaining + Detail Link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_clock" />

        <TextView
            android:id="@+id/card_deadline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="&#x622a;&#x6b62;&#x65f6;&#x95f4;"
            android:textColor="#BD5267"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/card_remaining_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="&#x5269;&#x4f59;&#x65f6;&#x95f4;"
            android:textColor="#8F9BB3"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="&#x67e5;&#x770b;&#x8be6;&#x60c5;"
            android:textColor="#6172D5"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
