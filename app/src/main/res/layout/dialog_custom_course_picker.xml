<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Top Header: Badge + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tag_custom"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="&#x5f53;&#x524d;&#x5b66;&#x671f;&#x8bfe;&#x7a0b;"
            android:textColor="#6574C8"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/course_picker_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:text="&#x9009;&#x62e9;&#x6240;&#x5c5e;&#x8bfe;&#x7a0b;"
        android:textColor="#1E2941"
        android:textSize="20sp" />

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_course_detail_card"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/course_picker_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:text="&#x6682;&#x65e0;&#x5f53;&#x524d;&#x5b66;&#x671f;&#x8bfe;&#x8868;&#x8bb0;&#x5f55;"
            android:textColor="#8E9AA8"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.bupt.schedule.ui.DetailScrollView
            android:id="@+id/course_picker_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/course_picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.bupt.schedule.ui.DetailScrollView>
    </LinearLayout>

    <!-- Bottom Action Button -->
    <Button
        android:id="@+id/course_picker_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_secondary_button"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="&#x53d6;&#x6d88;"
        android:textColor="#748197"
        android:textSize="15sp" />
</LinearLayout>
