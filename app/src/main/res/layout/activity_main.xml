<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/schedule_background">

    <ScrollView
        android:id="@+id/login_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="84dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="北邮课程表"
                android:textColor="#1E2941"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="使用移动教务账号获取真实课表"
                android:textColor="#8792A8"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:fontFamily="sans-serif-medium"
                android:text="学号"
                android:textColor="#45516A"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/account_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:background="@drawable/bg_login_input"
                android:hint="请输入学号"
                android:importantForAutofill="yes"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#26324B"
                android:textColorHint="#B1B8C6"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="教务密码"
                android:textColor="#45516A"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/bg_login_input"
                android:hint="请输入教务密码"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#26324B"
                android:textColorHint="#B1B8C6"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="云邮密码（可选）"
                android:textColor="#45516A"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/teaching_cloud_password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/bg_login_input"
                android:hint="云邮密码（可选）"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#26324B"
                android:textColorHint="#B1B8C6"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/teaching_cloud_password_helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="留空不影响教务课表，可在作业页随时配置"
                android:textColor="#8792A8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_error_message"
                android:padding="10dp"
                android:textColor="#A9495D"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="登录并获取课表"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/login_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="18dp"
                android:indeterminateTint="#6878D6"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="所有凭据仅在本机用 Android Keystore 加密保存"
                android:textColor="#A0A9BA"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/schedule_background"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/pages_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/schedule_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/schedule_background"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/schedule_surface"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/semester_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="#1E2941"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/week_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_week_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="62dp"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="9dp">

                    <TextView
                        android:id="@+id/week_badge_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#59667F"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="切换教学周"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F5F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/week_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#5E6980"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/assignment_switch_container"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/assignment_switch_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="&#x4f5c;&#x4e1a;"
                        android:textColor="#5E6980"
                        android:textSize="11sp" />

                    <com.bupt.schedule.ui.ToggleSwitch
                        android:id="@+id/assignment_toggle_switch"
                        android:layout_width="32dp"
                        android:layout_height="17dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_refresh_capsule"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/refresh_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="刷新课表"
                        android:src="@drawable/ic_refresh_cw" />

                    <TextView
                        android:id="@+id/refresh_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#6A778F"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.bupt.schedule.ui.ScheduleView
                android:id="@+id/schedule_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_schedule_surface"
                android:clipToOutline="true"
                android:contentDescription="本周课程表，完整显示周一至周日和第1至14节"
                android:elevation="3dp" />

            <ProgressBar
                android:id="@+id/schedule_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="#6878D6"
                android:visibility="gone" />

            <TextView
                android:id="@+id/schedule_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_error_message"
                android:gravity="center"
                android:maxLines="2"
                android:padding="9dp"
                android:textColor="#A9495D"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
            </LinearLayout>

            <!-- Standalone Assignment Page -->
            <LinearLayout
                android:id="@+id/assignment_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/schedule_background"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header Title Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/schedule_surface"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp">

                    <!-- Task title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="&#x4e91;&#x8bfe;&#x5802;&#x4f5c;&#x4e1a;"
                            android:textColor="#1E2941"
                            android:textSize="20sp" />

                    </LinearLayout>

                    <!-- Sync Status Weak Hint Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/assignment_cloud_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="云邮未配置"
                            android:textColor="#8E9AA8"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/assignment_reauth_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="配置云邮"
                            android:textColor="#BD5267"
                            android:textSize="11.5sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/assignment_unbind_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="清除云邮密码"
                            android:textColor="#8E9AA8"
                            android:textSize="11.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Filter Chips & Operations Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/schedule_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <!-- Left: Filter Chips -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:text="&#x5168;&#x90e8;"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/chip_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:text="&#x672a;&#x622a;&#x6b62;"
                            android:textColor="#5E6980"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/chip_overdue"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_filter_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:text="&#x5df2;&#x622a;&#x6b62;"
                            android:textColor="#5E6980"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Spacer -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Right: Stats + Refresh -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/assignment_stats_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-normal"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="共 0 项"
                            android:textColor="#8E9AA8"
                            android:textSize="11.5sp" />

                        <LinearLayout
                            android:id="@+id/assignment_refresh_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_refresh_capsule"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="9dp">

                            <ImageView
                                android:id="@+id/assignment_refresh_icon"
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:contentDescription="Refresh"
                                android:src="@drawable/ic_refresh_cw" />

                            <TextView
                                android:id="@+id/assignment_refresh_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="刷新"
                                android:textColor="#6A778F"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F5F8" />

                <!-- Scrollable Content -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="20dp">

                        <!-- Cards Container -->
                        <LinearLayout
                            android:id="@+id/assignment_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Empty Placeholder View -->
                        <LinearLayout
                            android:id="@+id/assignment_empty_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="60dp"
                            android:paddingBottom="60dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_book_open" />

                            <TextView
                                android:id="@+id/assignment_empty_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="暂无任务"
                                android:textColor="#8E9AA8"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/assignment_empty_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="当前没有未提交的作业或测验"
                                android:textColor="#A5B0C2"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/assignment_empty_action"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_filter_chip_selected"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="配置云邮"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </FrameLayout>

        <!-- Top Divider of Bottom Navigation Bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.75dp"
            android:background="#EAEFF5" />

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/bottom_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/schedule_surface"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Schedule -->
            <LinearLayout
                android:id="@+id/tab_schedule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_schedule_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_tab_schedule" />

                <TextView
                    android:id="@+id/tab_schedule_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="&#x8bfe;&#x7a0b;&#x8868;"
                    android:textColor="#6172D5"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Tab 2: Assignment -->
            <LinearLayout
                android:id="@+id/tab_assignment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_assignment_icon"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_tab_assignment" />

                <TextView
                    android:id="@+id/tab_assignment_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="&#x4f5c;&#x4e1a;"
                    android:textColor="#8E9AA8"
                    android:textSize="9.5sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
