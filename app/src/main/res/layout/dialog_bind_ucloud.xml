<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/bind_ucloud_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="配置云邮"
            android:textColor="#1E2941"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/bind_ucloud_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_course_detail_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Account Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="&#x5f53;&#x524d;&#x5b66;&#x53f7;"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bind_ucloud_account"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="-"
                android:textColor="#222B45"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EDF1F7" />

        <!-- Password Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="云邮密码"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/bind_ucloud_password_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_input"
                android:hint="请输入云邮密码"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#26324B"
                android:textColorHint="#B1B8C6"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/bind_ucloud_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_error_message"
        android:padding="10dp"
        android:textColor="#A9495D"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:lineSpacingExtra="2dp"
        android:text="云邮密码验证成功后仅加密保存在本机；进入作业页时会更新任务。"
        android:textColor="#8F9BB3"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/bind_ucloud_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:indeterminateTint="#6878D6"
        android:visibility="gone" />

    <!-- Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bind_ucloud_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_unselected"
            android:text="取消"
            android:textColor="#5E6980"
            android:textSize="14sp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/bind_ucloud_submit_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:text="登录云邮"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
