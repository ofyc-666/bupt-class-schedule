<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Top Header: Tag Badge + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/course_detail_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_course_detail_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="&#x8bfe;&#x7a0b;&#x8be6;&#x60c5;"
            android:textColor="#BD5267"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/course_detail_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="close"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- Course Title -->
    <TextView
        android:id="@+id/course_detail_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:text="&#x8bfe;&#x7a0b;&#x540d;&#x79f0;"
        android:textColor="#1E2941"
        android:textSize="20sp" />

    <!-- Info Box Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_course_detail_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Item 1: Teacher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="&#x6388;&#x8bfe;&#x6559;&#x5e08;"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/course_detail_teacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="-"
                android:textColor="#222B45"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EDF1F7" />

        <!-- Item 2: Teaching Class -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="&#x6559;&#x5b66;&#x73ed;"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/course_detail_teaching_class"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="-"
                android:textColor="#222B45"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EDF1F7" />

        <!-- Item 3: Classroom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="&#x4e0a;&#x8bfe;&#x6559;&#x5ba4;"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/course_detail_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="-"
                android:textColor="#BD5267"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EDF1F7" />

        <!-- Item 4: Time (Specific Clock Times and Slots/Weekday) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:text="&#x4e0a;&#x8bfe;&#x65f6;&#x95f4;"
                android:textColor="#8F9BB3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/course_detail_clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="-"
                    android:textColor="#222B45"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/course_detail_time_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-"
                    android:textColor="#60708F"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Confirm Button -->
    <Button
        android:id="@+id/course_detail_confirm_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_course_detail_button"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:text="&#x77e5;&#x9053;&#x4e86;"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />
</LinearLayout>